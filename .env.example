# Resend Email Delivery Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The verified sender address in your Resend account.
# For initial testing before custom domain verification, Resend provides:
# CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
# For production after verifying your custom domain in Resend:
# CONTACT_FROM_EMAIL="P Pirunthan Portfolio <inquiries@yourdomain.com>"
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
